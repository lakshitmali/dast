ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_NAME=DAST Platform
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DEBUG=true
ALLOW_LOCAL_TARGETS=false
NUCLEI_PATH=C:\\Tools\\nuclei.exe
